@model MVC_App.Models.Programm

@{
    ViewData["Title"] = "Create";
}

<h1>Δημιουργία Προγράμματος</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ProgrammName" class="control-label">Program Name</label>
                <input asp-for="ProgrammName" class="form-control" />
                <span asp-validation-for="ProgrammName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Benfits" class="control-label"></label>
                <input asp-for="Benfits" class="form-control" />
                <span asp-validation-for="Benfits" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Charge" class="control-label"></label>
                <input asp-for="Charge" class="form-control" />
                <span asp-validation-for="Charge" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
